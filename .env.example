# MariaDB 10.11+ / MySQL 8.0.16+. No embedded database fallback.
# Hostinger: use the full database/user names (including the u... prefix).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=5
DB_SSL=false
# Optional alternative: mysql://user:encoded-password@host:3306/database
# Leave empty when using the separate DB_* values above.
DATABASE_URL=
APP_URL=http://localhost:3000
DEMO_MODE=true
# CLI-only administrator setup; never exposed to the browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Agency Administrator
# Optional Resend email. Without these, only in-app notifications are created.
RESEND_API_KEY=
EMAIL_FROM=
# Card processing is intentionally disabled until a provider adapter is installed.
# Local integration tests use a dedicated user with CREATE/DROP on lakbay_test_*.
# Never use the live database or live database credentials for tests.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3306
TEST_DB_USER=
TEST_DB_PASSWORD=

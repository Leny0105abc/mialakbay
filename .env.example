# Leave empty for embedded PostgreSQL (PGlite), persisted in .data/postgres.
# Production: use a dedicated PostgreSQL database and run npm run db:migrate.
DATABASE_URL=
APP_URL=http://localhost:3000
DEMO_MODE=true
PGLITE_PATH=./.data/postgres
# CLI-only administrator setup; never exposed to the browser.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Agency Administrator
# Optional Resend email. Without these, only in-app notifications are created.
RESEND_API_KEY=
EMAIL_FROM=
# Card processing is intentionally disabled until a provider adapter is installed.

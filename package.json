    "admin:create": "tsx scripts/create-admin.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "maintenance": "tsx scripts/maintenance.ts",
    "format": "prettier --write src scripts tests *.json *.ts *.mjs README.md docs/*.md"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "dotenv": "^18.0.9",
    "lucide-react": "^0.468.0",
